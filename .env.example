# Copy to .env and fill in what you use

# Data folders (defaults: data/raw, data/processed, data/index)
# RAW_DIR=
# PROCESSED_DIR=

# Speech-to-text
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8      # int8 (CPU) | float16 (GPU)

# Speaker diarization (accept terms for pyannote/speaker-diarization-3.1 on Hugging Face)
HF_TOKEN=

# Vision captioning for video frames: anthropic | openai | none
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Chunking
CHUNK_SECONDS=45
CHUNK_OVERLAP_SECONDS=8

# Keyframes
KEYFRAME_FPS=2                 # sampling rate for change detection
KEYFRAME_CHANGE=0.012          # new slide = >1.2% of pixels changed vs last kept frame...
KEYFRAME_STABLE=0.004          # ...and then held still (slides are static, webcams are not)
SCENE_THRESHOLD=0.30           # hard cut = >30% of pixels changed at once
MAX_FRAME_GAP_SECONDS=30       # force a frame at least this often

# ---- Week 2: embeddings + vector store ----
EMBED_BACKEND=st               # st (real models) | hash (offline, for tests/demo)
TEXT_EMBED_MODEL=intfloat/multilingual-e5-small   # or BAAI/bge-m3 for best quality
CLIP_IMAGE_MODEL=clip-ViT-B-32
CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
EMBED_DEVICE=                  # blank = auto (cuda/mps/cpu)
# INDEX_DIR=data/index
# QDRANT_URL=                  # set to use a Qdrant server / Qdrant Cloud instead of local files
# QDRANT_API_KEY=

# Hybrid retrieval weights (Reciprocal Rank Fusion)
RRF_K=60
WEIGHT_DENSE=1.0
WEIGHT_BM25=0.8
WEIGHT_VISUAL=0.6

# ---- Week 3: answering + voice ----
LLM_PROVIDER=anthropic         # anthropic | openai | ollama (Llama/Mistral/Qwen) | fake
LLM_MODEL=                     # blank = provider default (claude-haiku-5-5 / gpt-4o-mini / llama3.1:8b)
LLM_BASE_URL=                  # ollama: http://localhost:11434/v1 ; also vLLM, Groq, Together
LLM_MAX_TOKENS=700
RETRIEVAL_K=5

STT_PROVIDER=whisper           # whisper | fake
STT_MODEL=                     # blank = WHISPER_MODEL; or path to your fine-tuned model (Week 4)
VAD_SILENCE_MS=700             # pause length that ends your turn
BARGE_IN=true                  # talk over the assistant to interrupt it

TTS_PROVIDER=edge              # edge (free, great Hindi) | openai | piper (offline) | none
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
PIPER_MODEL_EN=
PIPER_MODEL_HI=

# ---- Week 5: evaluation ----
# Judge with a stronger model than the one answering, e.g.:
#   python scripts/evaluate.py rag --judge-provider anthropic --judge-model claude-sonnet-5-5
# REPORTS_DIR=reports
# FEEDBACK_DATASETS_DIR=data/feedback_datasets
